+/* Match the SNES cartridge address-line mirroring for non-power-of-two ROMs. */
+static Uint32 SnesSuperFXMirrorRomOffset(Uint32 uSize, Uint32 uPos)
+{
+	Uint32 uMask;
+	if (uSize == 0 || uPos < uSize)
+		return (uSize == 0) ? 0 : uPos;
+	uMask = 0x80000000u;
+	while (!(uPos & uMask)) uMask >>= 1;
+	if (uSize <= (uPos & uMask))
+		return SnesSuperFXMirrorRomOffset(uSize, uPos - uMask);
+	return uMask + SnesSuperFXMirrorRomOffset(uSize - uMask, uPos - uMask);
+}
+
+static Uint8 SnesSuperFXSnoozeVector(Uint32 uAddr)
+{
+	switch (uAddr & 0x0F)
+	{
+	case 0x0: case 0x2: case 0x6: case 0x8: case 0xC: return 0x00;
+	case 0x4: return 0x04;
+	case 0xA: return 0x08;
+	case 0xE: return 0x0C;
+	default:  return 0x01;
+	}
+}
+
+static SnesSuperFXDebugSnapshotT g_SnesSuperFXDebugSnapshot = {};
+
+void SnesGetSuperFXDebugSnapshot(SnesSuperFXDebugSnapshotT *pOut)
+{
+    if (pOut) *pOut = g_SnesSuperFXDebugSnapshot;
+}
