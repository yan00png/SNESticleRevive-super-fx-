+void SnesSystem::SyncGSUTo(Int32 nClock)
+{
+    if (!m_bSuperFX)
+        return;
+    if (nClock < 0) nClock = 0;
+    if (nClock > SNES_CYCLESPERLINE) nClock = SNES_CYCLESPERLINE;
+    if (nClock <= m_nGSULineClock)
+        return;
+#if SNDBG_LOG
