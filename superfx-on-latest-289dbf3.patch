+    m_GSU.RunMasterCycles(nClock - m_nGSULineClock);
+#if SNDBG_LOG
+    g_TmgCycGSU += ProfCtrGetCycle() - uStart;
+#endif
+    m_nGSULineClock = nClock;
+    RefreshSCPUIRQ();
+}
