+++ b/tools/superfxtest/state_roundtrip.cpp
@@ -0,0 +1,20 @@
+#include "sngsu.h"
+#include <stdio.h>
+#include <string.h>
+extern "C" void DLog(const char *, ...) {}
+int main(){
+  Uint8 rom[0x10000]; Uint8 ram[0x20000]; memset(rom,0x01,sizeof rom); memset(ram,0,sizeof ram);
+  SNGSU g; g.SetVersion(0x04); g.SetMemory(rom,sizeof rom,ram,sizeof ram);
+  g.WriteReg(0x3002,0x34); g.WriteReg(0x3003,0x12); // R1=1234
+  g.WriteReg(0x303A,0x29); // SCMR
+  g.WriteReg(0x3037,0x80); // IRQ mask
+  g.WriteReg(0x301E,0x00); g.WriteReg(0x301F,0x00); // GO
+  SNGSU::State state; memset(&state,0xA5,sizeof state); g.SaveState(&state);
+  g.WriteReg(0x3002,0x78); g.WriteReg(0x3003,0x56); g.WriteReg(0x303A,0);
+  g.RestoreState(&state);
+  if(g.GetReg(1)!=0x1234 || !g.IsRunning() || g.GetSCMR()!=0x29 || (g.GetSFR() & 0x20)!=0x20) {
+    printf("FAIL reg=%04X go=%d scmr=%02X sfr=%04X\n",g.GetReg(1),g.IsRunning(),g.GetSCMR(),g.GetSFR()); return 1;
+  }
+  printf("PASS GSU state round-trip: R1=%04X GO=%u SCMR=%02X SFR=%04X size=%u\n",g.GetReg(1),g.IsRunning(),g.GetSCMR(),g.GetSFR(),(unsigned)sizeof state);
+  return 0;
+}
